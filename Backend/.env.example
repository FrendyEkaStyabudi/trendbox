# Copy file ini menjadi .env atau set lewat Environment Variables jika diperlukan.
# run_backends.py sudah mengirim nilai default ini ke service Flask.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trendbox-app
DB_PASSWORD=replace-with-a-secret
DB_DATABASE=trendbox
DB_NAME=trendbox
INSTANCE_CONNECTION_NAME=trendbox-2026:asia-southeast2:trendbox-mysql

# Untuk CORS development LAN, boleh dibiarkan *.
# Kalau ingin spesifik: http://localhost:3000,http://192.168.1.20:3000
FRONTEND_ORIGINS=*
