# Copy file ini menjadi .env.local di laptop frontend/backend.
# Ganti IP sesuai jaringan lokal kamu.

# Backend utama di laptop lain / laptop frontend-backend
NEXT_PUBLIC_API_BASE_URL=https://trendbox-dashboard-api-590242083739.asia-southeast2.run.app
NEXT_PUBLIC_REPORT_API_BASE_URL=https://trendbox-reports-api-590242083739.asia-southeast2.run.app
NEXT_PUBLIC_NLP_API_BASE_URL=https://trendbox-nlp-api-590242083739.asia-southeast2.run.app

# Realtime detection berjalan di browser melalui WebGPU.
# Naikkan nilainya bila perangkat lambat untuk mengurangi beban inferensi.
NEXT_PUBLIC_WEBGPU_FRAME_INTERVAL_MS=180
NEXT_PUBLIC_MODEL_BASE_URL=https://storage.googleapis.com/trendbox-web-models-590242083739
